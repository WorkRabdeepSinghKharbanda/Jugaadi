# Copy to .env (gitignored). Loaded with: flutter run --dart-define-from-file=.env
# Android emulator -> http://10.0.2.2:3000 · iOS sim -> http://localhost:3000 · device -> http://<mac-lan-ip>:3000
API_BASE_URL=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Microsoft Clarity project id: session replay + heatmaps. Public id, not a secret. Empty = off.
CLARITY_PROJECT_ID=
