# Server
PORT=3000
NODE_ENV=development

# Supabase project (Settings -> API). Service-role key: full DB access, server-only, never ship to the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# MVP-only admin gate (single shared secret header, no multi-admin auth yet).
# Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Razorpay (Pro plan checkout). Dashboard -> Settings -> API Keys for the first two (test mode
# while developing, rzp_test_... prefix). Missing either = /billing/checkout answers 501.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> the secret you set when registering
# https://<api-host>/billing/webhook. Generate with: openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=
